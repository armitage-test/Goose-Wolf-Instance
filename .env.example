# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Gmail account used to SEND the trend report
GMAIL_ADDRESS=you@gmail.com

# App-specific password (NOT your Gmail login password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address that receives the report (can be the same as GMAIL_ADDRESS)
RECIPIENT_EMAIL=you@example.com
